# =============================================================================
# Hapstore: THE CORE — environment configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder — no real credential belongs in this file.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Directory for persistent state (must match the Docker volume mount).
DATA_DIR="/app/data"

# Public URL of the deployment. Used for CORS and Telegram Mini App links.
WEB_APP_URL="https://example.com"

# Login name that authenticates against ADMIN_PASSWORD_HASH below.
ADMIN_LOGIN="admin"

# --- Security (REQUIRED — the server refuses to start without these) --------

# PBKDF2 hash of the administrator password in "salt:hash" form.
# Generate with:  npm run hash-password -- 'your-strong-password'
ADMIN_PASSWORD_HASH=""

# Key used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Shared secret between the game server and the Telegram bot container,
# protecting the internal /api/admin/bot-* endpoints. Generate the same way.
INTERNAL_API_SECRET=""

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_GROUP_CHAT_ID=""
TELEGRAM_ADMIN_USERNAME="@your_admin_username"

# Тихие часы бота (Москва): напоминания о ходе не шлём. Отчёт — в 21:00.
TELEGRAM_QUIET_START="23"
TELEGRAM_QUIET_END="8"
TELEGRAM_REPORT_HOUR="21"

# The bot token is also what verifies Telegram Mini App sign-ins: initData is
# signed with it, so the server can recognise a player without a password.
# Leave it empty and the "ИГРАТЬ" button falls back to the password form.

# Bot API endpoint. Only change this to point at a self-hosted Bot API server;
# the end-to-end suite overrides it to reach a local stub.
# TELEGRAM_API_ROOT="https://api.telegram.org"

# Outbound proxy for Telegram traffic. Leave empty for a direct connection.
#
# Needed when the host cannot reach api.telegram.org at all — the symptom is
# `connect ETIMEDOUT 149.154.x.x:443` in the bot log on every attempt. Check
# from the server with:  curl -v -m 15 https://api.telegram.org
#
# Used by BOTH containers. The bot receives updates; the game server sends
# turn requests, prize announcements and registration alerts. Setting it for
# only one of them yields a bot that answers /start while every in-game
# notification silently disappears.
#
# SOCKS5 is recommended. DNS is always resolved by the proxy (socks5:// is
# upgraded to socks5h:// automatically), because where Telegram is blocked its
# DNS records usually are too.
# Можно указать НЕСКОЛЬКО адресов через запятую — бот проверит их по порядку,
# возьмёт первый рабочий и сам переключится на следующий, когда тот откажет.
# Порядок задаёт приоритет: как только первый оживёт, бот вернётся к нему.
# Бесплатные прокси живут часы, поэтому список из 3–5 адресов практичнее одного.
#
#   TELEGRAM_PROXY="socks5://a.example:1080,socks5://b.example:1080"
#   TELEGRAM_PROXY="socks5://user:password@host:1080"
#   TELEGRAM_PROXY="http://user:password@host:3128"
#
# MTProto (mtproto:// и tg://proxy) НЕ ПОДДЕРЖИВАЕТСЯ и поддержан быть не может:
# он проксирует протокол клиентов Telegram, а бот обращается к api.telegram.org
# обычными HTTPS-запросами. Это разные протоколы. Нужен SOCKS5 или HTTP.
#
# ВАЖНО: с версии 2026-08-05.3 адреса отсюда НЕ используются, пока работает
# контейнер hcg_proxy. Он сам находит прокси, проверяет их каждые несколько
# минут и сортирует по скорости — его список полностью замещает этот.
# Значение ниже нужно лишь на первом запуске, пока сборщик не отработал
# первый цикл, и как запасной вариант, если он остановлен. Можно оставить
# пустым: TELEGRAM_PROXY=""
#
# Проверено 5 августа 2026 года настоящим запросом getMe к api.telegram.org
# (Telegram ответил «401 invalid token» — значит, маршрут до него живой):
#   socks5://144.22.165.206:1088   — 3.1 с
#   socks5://101.36.104.239:10808  — 1.2 с
#   socks5://220.158.232.118:1080  — 21 с, держим последним
# Не прошли проверку, в список не включены: 121.169.46.116:1090 (обрывает
# соединение) и 212.58.132.5:1080 (порт открыт, трафик не идёт) — ровно тот
# случай, когда «порт открыт» ещё ничего не значит.
TELEGRAM_PROXY="socks5://101.36.104.239:10808,socks5://144.22.165.206:1088,socks5://220.158.232.118:1080"

# Как часто перепроверять текущий прокси, мс. По умолчанию 5 минут.
# Для нестабильных бесплатных адресов имеет смысл уменьшить до 60000.
TELEGRAM_PROXY_CHECK_MS="60000"

# --- Firebase (Firestore via the Admin SDK) ---------------------------------
# The server authenticates with a SERVICE ACCOUNT. Admin SDK requests bypass
# security rules, which is what allows firestore.rules to deny all public
# access. Without one of the two options below Firestore stays disabled and
# state is persisted to local disk only.
#
# Create the key: Firebase Console -> Project settings -> Service accounts
#                 -> "Generate new private key"
#
# ⚠️  This key grants FULL database access. Never commit it.

# Option A — the key file contents, as a single-line JSON string.
#            Best for secret managers, Cloud Run and CI.
FIREBASE_SERVICE_ACCOUNT=""

# Option B — path to the key file on disk (mount it read-only in Docker).
GOOGLE_APPLICATION_CREDENTIALS=""

# Target project/database. project_id is inferred from the key when omitted.
FIREBASE_PROJECT_ID=""
FIREBASE_FIRESTORE_DATABASE_ID=""

# --- Legacy client-SDK values (no longer used for persistence) --------------
# Kept so older deployments do not fail on unknown variables. The web API key
# is NOT a server credential and is ignored by the Admin SDK integration.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_APP_ID=""
FIREBASE_CONFIG=""

# --- Migration (optional) ---------------------------------------------------
# Only needed once, to decrypt passwords stored by an old release that used
# AES-CBC. Remove after the migration has run.
LEGACY_AES_PASSWORD=""

# --- Optional ---------------------------------------------------------------
# Unused by the current codebase; kept for future AI features.
GEMINI_API_KEY=""

# --- Сборщик прокси (контейнер hcg_proxy) -----------------------------------
# Ищет рабочие прокси на публичных сайтах, проверяет каждый настоящим запросом
# к api.telegram.org и удаляет умершие. Бот и сервер подхватывают список из
# общего тома без перезапуска.
#
# Адреса из TELEGRAM_PROXY выше закреплены: найденные автоматически их
# не вытесняют. Если своих адресов нет — оставьте TELEGRAM_PROXY пустым,
# сборщик наполнит список сам.
#
# Полный цикл, мс. По умолчанию 10 минут. Скачивание списков происходит только
# когда рабочих адресов меньше HARVEST_TARGET, поэтому в спокойное время
# нагрузки почти нет.
# HARVEST_INTERVAL_MS="600000"
#
# Одновременных проверок. Больше — быстрее, но выше нагрузка на сеть сервера.
# HARVEST_CONCURRENCY="120"
#
# Предельное время одной проверки, мс. Меньше 5000 отсеивает живые, но
# медленные прокси.
# HARVEST_TIMEOUT_MS="10000"
#
# Сколько рабочих адресов достаточно, чтобы не трогать источники.
# HARVEST_TARGET="12"
#
# Потолок списка: худшие сверх этого удаляются.
# HARVEST_MAX="30"
