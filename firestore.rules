rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------------
    // DENY EVERYTHING BY DEFAULT.
    //
    // The game server is the only component that touches Firestore, and it
    // must authenticate with a service account via the Firebase Admin SDK.
    // Admin SDK requests bypass these rules entirely, so no public access
    // rule is required.
    //
    // The previous configuration exposed /game/{docId} with
    // `allow read, write: if true`, which let anyone holding the (public)
    // web API key read every player's password hash and overwrite the whole
    // game state directly from the internet.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
