# =============================================================================
#  HCG Production — .gitignore
# =============================================================================
#  Правило простое: в репозиторий попадает только исходный код.
#  Всё, что генерируется, содержит секреты или меняется во время игры, —
#  остаётся на сервере.
# =============================================================================

# --- Зависимости и сборка ----------------------------------------------------
# Восстанавливаются командой npm ci из package-lock.json.
node_modules/
dist/
build/
out/
coverage/
*.tsbuildinfo

# --- СЕКРЕТЫ: никогда не коммитить -------------------------------------------
# Именно отсюда утёк токен бота в прошлый раз.
.env
.env.*
!.env.example

# Ключи Firebase и любые сервисные аккаунты.
firebase-applet-config.json
*serviceAccount*.json
*service-account*.json
*credentials*.json
*-firebase-adminsdk-*.json

# Криптографические ключи и учётные данные.
*.pem
*.key
*.p12
*.pfx
*.crt
.netrc
.git-credentials

# --- Состояние игры (живёт в томе Docker, не в коде) -------------------------
# Ведущий слэш обязателен: он привязывает правило к корню репозитория.
# Без него правило поймало бы src/game/data/ — описание доски, которое
# обязано быть в репозитории. Именно так однажды пропали 65 клеток.
/data/

*-persistent.json
game-state-persistent.json
game-auth-persistent.json
game-calibration-persistent.json
game-logs-archive.jsonl
telegram_users.json
admin_list.json
registration-requests.json
snapshots/

# --- Резервные копии (часто содержат секреты) --------------------------------
*.bak
*.backup
*.orig
*.old
*.save
*~
docker-compose.yml.bak

# --- Логи и отладка ----------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- Временные файлы и патчи -------------------------------------------------
*.patch
*.diff
*.tmp
tmp/
.cache/

# --- Служебные файлы ОС ------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# --- Настройки редакторов ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# --- Прочие менеджеры пакетов ------------------------------------------------
# Проект использует npm; чужие lock-файлы приводят к разным сборкам.
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# --- Архивы ------------------------------------------------------------------
# Готовые сборки не хранятся в репозитории.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
