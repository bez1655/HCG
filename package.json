{
  "name": "hapstore-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:bot": "npm --prefix bot run start",
    "install:bot": "npm --prefix bot ci",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "fix-perms": "bash scripts/fix-permissions.sh",
    "check-perms": "bash scripts/fix-permissions.sh --check",
    "lint": "tsc --noEmit && eslint .",
    "hash-password": "node scripts/hash-password.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-secrets": "node scripts/check-secrets.mjs --all",
    "hooks:install": "git config core.hooksPath .githooks && echo \"Git hooks enabled.\"",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "setup-env": "node scripts/setup-env.mjs",
    "restore": "node scripts/restore-snapshot.mjs",
    "snapshot:list": "node scripts/restore-snapshot.mjs --list",
    "lint:types": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test && npm run test:e2e",
    "verify": "bash scripts/verify-deployment.sh",
    "check-env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^5.2.1",
    "firebase-admin": "^14.1.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socks-proxy-agent": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "uuid": "^11.1.0",
    "fast-xml-parser": "^5.10.1",
    "postcss": "^8.5.24",
    "nanoid": "^3.3.18"
  }
}
