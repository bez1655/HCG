<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Полный запрет незашифрованного HTTP трафика -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Конфигурация для игрового домена HCG -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">hapstore.cyber-game.online</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
